# OPTION 1 (recommended): replace YOUR_PASSWORD with your PostgreSQL password.
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/breakflow
CLIENT_ORIGIN=http://localhost:5173

# OPTION 2: if you prefer separate settings, comment out DATABASE_URL above
# and uncomment these lines, then replace YOUR_PASSWORD.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=breakflow
# PGUSER=postgres
# PGPASSWORD=YOUR_PASSWORD

# Starter administrator credentials (change before using real employee data)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
